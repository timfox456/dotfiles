      "git push*": "ask",
      "*": "allow"
    }
  },
  "compaction": { "prune": true },
  "agent": {
    "general": { "model": "opencode-go/glm-5.3-flash" },
    "explore": { "model": "opencode-go/glm-5.3-flash" },
    "summary": { "model": "opencode-go/glm-5.3-flash" },
    "compaction": { "model": "opencode-go/glm-5.3-flash" },
    "title": { "model": "opencode-go/mimo-v2.5" }
  }
}
