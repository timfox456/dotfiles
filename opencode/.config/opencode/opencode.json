{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/mimo-v2.5-pro",
  "small_model": "opencode-go/glm-5.3-flash",
  "share": "disabled",
  "autoupdate": true,
  "instructions": ["~/.config/opencode/instructions.md"],
  "permission": {
    "edit": "allow",
    "webfetch": "allow",
