# ~/.config/ghostty/config

# Font (Nerd Font for Neovim icons)
font-family = "JetBrainsMono Nerd Font Mono"
font-size = 14

# Cursor
cursor-style = "block"
cursor-style-blink = true

# Window padding
window-padding-x = 2
window-padding-y = 2

# Theme: full catppuccin mocha palette (matches nvim + tmux)
theme = "Catppuccin Mocha"

# macOS: send Option as a real Alt modifier (M-hjkl resize, M-s sessionizer)
macos-option-as-alt = true

# Shell integration — auto-detect (don't hardcode zsh; Linux servers may only have bash)
shell-integration-features = "no-cursor"

# Auto-attach tmux on launch.
# tmux is exec'd directly (no /bin/zsh wrapper): this package is stowed on
# Linux desktops too, where /bin/zsh may not exist, and tmux spawns the
# configured default-shell for its panes anyway.
# `new-session -A -s <name>` = attach if it exists, create otherwise.
command = tmux new-session -A -s main
