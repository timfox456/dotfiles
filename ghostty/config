-- ~/.config/ghostty/config

return {
    -- === General Settings ===
    -- Set your preferred font and size. Make sure it's a Nerd Font for Neovim icons!
    font = "Hack Nerd Font Mono", -- Replace with your preferred Nerd Font (e.g., FiraCode Nerd Font, JetBrainsMono Nerd Font)
    font_size = 14,             -- Adjust to your preference

    -- Basic cursor style
    cursor_style = "Block",
    cursor_blink = true,

    -- Window padding (optional, but can make things look nicer)
    padding_x = 2,
    padding_y = 2,

    -- Theme
    -- Ghostty can use themes. You can explore themes in Ghostty's documentation.
    -- For now, let's stick with a simple background for clarity.
    -- You can set 'background' to a specific color or just let your shell's colors handle it.
    background = "#1E1E2E", -- Catppuccin Mocha Background (matches your Neovim theme)
    foreground = "#CDD6F4", -- Catppuccin Mocha Foreground

    -- Smooth scrolling (optional, uncomment if you prefer pixel-perfect scrolling)
    -- scroll_lines = 1,

    -- === Tmux Integration ===
    -- This is the most important part for your workflow.
    -- It tells Ghostty to attach to an existing tmux session or create a new one.
    -- Using the shell's -c flag ensures your .zshrc/.bashrc is sourced.
    default_cmd = { "/bin/zsh", "-c", "tmux attach || tmux new-session" },
    -- If you use Bash, change "/bin/zsh" to "/bin/bash"

    -- === Performance & Rendering (Often good defaults, but here for awareness) ===
    -- render_mode = "Auto", -- "Auto" (default), "Greedy", "Lazy"
    -- input_latency = 0,    -- 0 means send input immediately (good for low latency)

    -- === macOS Specific Enhancements (Optional) ===
    -- Option key behavior (e.g., to use Alt/Option for meta key)
    -- You might need to adjust this depending on how you use your Alt key in Neovim
    -- For most users, "Meta" is desired to send Alt+key combinations.
    option_as_alt = "Both", -- "Both", "Left", "Right", "None"

    -- Copy/Paste behavior (system clipboard)
    -- Ghostty should automatically handle system clipboard, but these are options
    -- copy_on_select = false,
    -- paste_on_middle_click = false,
}
