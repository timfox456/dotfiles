# zerostack configuration — per-machine copy (install-deps.sh seeds this once).
# NEVER put API keys here if this file is a symlink into the dotfiles repo;
# this is a real copy, so machine-local edits (like [api_keys]) stay local.
# Docs: https://github.com/gi-dellav/zerostack/blob/main/docs/CONFIG.md
#
# Recommended auth: export OPENROUTER_API_KEY="sk-or-..." in ~/.bashrc
# (get a key at https://openrouter.ai/keys). Never commit it.

provider = "openrouter"
# model = "deepseek/deepseek-v4-flash"   # browse: https://openrouter.ai/models
compact_enabled = true
# default_prompt = "code"
# default_permission_mode = "standard"
