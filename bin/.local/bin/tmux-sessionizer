#!/usr/bin/env bash
# ThePrimeagen-style tmux sessionizer: pick a project with fzf and switch to
# (or create) a tmux session named after it. Project root is ~/timfox456
# (override with PROJECTS_DIR).
set -uo pipefail

PROJECTS_DIR="${PROJECTS_DIR:-$HOME/timfox456}"

# Use fzf-tmux for proper display when inside tmux
fzf_pick() {
  if [[ -n "${TMUX:-}" ]] && command -v fzf-tmux >/dev/null 2>&1; then
    fzf-tmux -p 80%,60%
  else
    fzf
  fi
}

if [[ $# -eq 1 ]]; then
  selected="$1"
else
  selected="$(find "$PROJECTS_DIR" -mindepth 1 -maxdepth 1 -type d | sort | fzf_pick)"
fi

[[ -z "${selected:-}" ]] && exit 0

selected_name="$(basename "$selected" | tr . _)"

tmux_running() {
  pgrep -x tmux >/dev/null 2>&1
}

# Not inside tmux and no server running: start one in this project.
if [[ -z "${TMUX:-}" ]] && ! tmux_running; then
  tmux new-session -s "$selected_name" -c "$selected"
  exit 0
fi

# From inside tmux we switch the current client; from a plain shell (server
# already running, no client here) switch-client has nothing to switch and
# errors out — attach instead.
goto_session() {
  if [[ -n "${TMUX:-}" ]]; then
    tmux switch-client -t "$1"
  else
    tmux attach-session -t "$1"
  fi
}

if tmux has-session -t "=$selected_name" 2>/dev/null; then
  goto_session "=$selected_name"
else
  # Window 1: nvim in the project; window 2: plain shell.
  # base-index is 1 (see tmux-common/common.conf) — name the window instead of
  # trusting the index, so a base-index change can't select the wrong one.
  tmux new-session -ds "$selected_name" -c "$selected" -n editor "nvim"
  tmux new-window -t "=$selected_name:" -c "$selected" -n shell
  tmux select-window -t "=$selected_name:editor"
  goto_session "=$selected_name"
fi
