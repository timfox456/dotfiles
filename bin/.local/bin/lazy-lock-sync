#!/usr/bin/env bash
# Copy the machine-local lazy lockfile into the repo (before committing).
# Run this after DELIBERATE plugin updates (:Lazy sync) so other machines
# converge to the new pins. Never needed for routine machine setup.
set -euo pipefail

STATE="$HOME/.local/state/nvim/lazy-lock.json"

# This script is stowed to ~/.local/bin, so $0 is usually a symlink into the
# repo — resolve it before deriving the repo root (bin/.local/bin/<me> -> ../../..).
SELF="$(readlink -f "$0" 2>/dev/null || echo "$0")"
REPO_ROOT="$(cd "$(dirname "$SELF")/../../.." && pwd)"
REPO_LOCK="$REPO_ROOT/nvim/.config/nvim/lazy-lock.json"

if [[ ! -f "$STATE" ]]; then
  echo "no state lockfile at $STATE — nothing to sync" >&2
  exit 1
fi
if [[ ! -f "$REPO_LOCK" ]]; then
  echo "repo lockfile not found at $REPO_LOCK (is $REPO_ROOT the dotfiles repo?)" >&2
  exit 1
fi

cp "$STATE" "$REPO_LOCK"
echo "synced state lockfile -> repo:"
git -C "$REPO_ROOT" diff --stat -- nvim/.config/nvim/lazy-lock.json || true
echo "now commit + push so other machines converge (they'll pick it up on the next ./install.sh)"
